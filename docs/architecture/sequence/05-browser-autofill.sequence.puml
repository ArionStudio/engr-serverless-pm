@startuml 05-browser-autofill
title Explicit popup Fill and login review
actor User as user
participant "Website (top frame)" as page
participant "Isolated content script" as content
participant "Popup + composed use cases" as popup
participant "Background + composed capture use cases" as bg
participant "Unlocked session" as vault
participant "Encrypted session capture" as pending

== Explicit Fill ==
user -> popup : Open toolbar popup
popup -> content : Inspect active tab via activeTab + scripting
content --> popup : Current URL, document token, supported form
popup -> vault : Read exact-origin matches while unlocked
vault --> popup : Entry IDs and visible fields only
user -> popup : Choose entry and click Fill
popup -> vault : Read selected entry under session lock
vault --> popup : Selected username/password
popup -> popup : Recheck active tab and URL
popup -> content : Fill, URL and document token
content -> content : Recheck token, URL, fields and form destination
alt Safe matching form
  content -> page : Set values; dispatch input/change
  content --> popup : Filled
else Page or form changed
  content --> popup : Refused
end
user -> page : Submit when ready

== Optional capture ==
user -> popup : Enable login detection; grant website access
popup -> content : Register bundled script for future pages
user -> page : Submit entered login
content -> bg : Trusted submission candidate, current URL
bg -> bg : Validate sender, top frame, origin and opt-in
bg -> vault : Require current unlocked session
alt New or changed login
  bg -> pending : Encrypt candidate bound to vault/session/tab; 2-minute expiry or opt-in session retention
  bg --> content : Offer review
  content -> user : Review login prompt
  user -> popup : Open review
  popup -> pending : Read/decrypt unexpired candidate in same session
  popup -> user : Existing Add/Edit entry form
  user -> popup : Confirm save/update
  popup -> vault : Existing CRUD use case with stale-edit protection
else Locked, duplicate or disallowed
  bg --> content : No capture
end
@enduml
