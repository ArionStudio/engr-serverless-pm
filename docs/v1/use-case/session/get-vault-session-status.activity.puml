@startuml get-vault-session-status-activity
title GetVaultSessionStatusUseCase - Activity

skinparam backgroundColor #FEFEFE
skinparam roundcorner 8
skinparam shadowing false
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
}

start
:Input:\nnone;
:Source:\npackages/core/src/use-cases/session/get-vault-session-status.ts;
:Enter shared cross-context clipboard/session coordinator;
:Read authoritative persisted session identity;
:Reconcile it with cached material, wiping and evicting stale material;
note right
This use case does not read or decrypt the encrypted session payload.
end note
if (reconciled active vault identity unavailable?) then (yes)
  :Return { status: "locked" };
  stop
else (no)
  :Return { status: "unlocked", vaultId };
  stop
endif
@enduml
