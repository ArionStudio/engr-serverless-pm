@startuml recover-device-access-activity
title RecoverDeviceAccessUseCase - Activity

skinparam backgroundColor #FEFEFE
skinparam roundcorner 8
skinparam shadowing false
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
}

start
:Input:\nvaultId, recoveryMnemonicKey, newMasterPassword;
:Source:\npackages/core/src/use-cases/device-trust/recover-device-access.ts;
:Calculate newMasterPassword strength;
if (password score below 4?) then (yes)
  :Throw InvalidNewMasterPasswordError;
  stop
endif
:Require vault can be activated locally;
if (another vault is active?) then (yes)
  :Throw activation error from session service;
  stop
endif

:Atomically read current device access material and recovery backup;
:Capture both revisions, both generations, or material absence;
if (backup missing?) then (yes)
  :Throw DeviceAccessRecoveryBackupNotFoundError;
  stop
endif
if (backup vault id differs?) then (yes)
  :Throw DeviceAccessRecoveryBackupMismatchError;
  stop
endif
if (backup algorithm unsupported?) then (yes)
  :Throw UnsupportedAlgorithmSuiteError;
  stop
endif
if (present material and backup vault, device, algorithm,\npublic keys, or localAccessGenerationId differ?) then (yes)
  :Throw DeviceAccessMaterialChangedError;
  stop
endif
:Validate present material and backup revisions are
positive safe integers with available exact successors;
if (either revision invalid or exhausted?) then (yes)
  :Throw DeviceAccessMaterialChangedError;
  stop
endif
:Generate a fresh localAccessGenerationId;
:Validate the generated generation ID;
if (generation ID invalid or reused?) then (yes)
  :Throw DeviceAccessMaterialChangedError;
  stop
endif

:Read local vault snapshot;
if (snapshot missing?) then (yes)
  :Throw VaultSnapshotNotFoundError;
  stop
endif
if (snapshot vault id differs?) then (yes)
  :Throw PersistedVaultMismatchError;
  stop
endif
if (snapshot algorithm unsupported?) then (yes)
  :Throw UnsupportedAlgorithmSuiteError;
  stop
endif

:Find recovered device envelope from backup deviceId;
if (device envelope missing?) then (yes)
  :Throw DeviceKeySlotNotFoundError;
  stop
endif

:Convert recovery mnemonic into recoverySecretKey;
:Derive recovery local-keys protection key;
:Unwrap backed-up local keys payload\n(devicePrivateSignKey + devicePrivateVaultKey +\ndeviceLocalProtectionKey + vaultTrustAnchor);
:Verify recovered private signing and vault keys\nmatch backup public keys;
if (private keys do not match backup?) then (yes)
  :Throw DeviceKeySlotVerificationFailedError;
  stop
endif
:Require snapshot trust chain and local trust checkpoint;
:Verify checkpoint for the backup device identity;
:Verify trust chain with recovered vaultTrustAnchor;
:Verify recovered private signing and vault keys\nmatch current trusted-device public keys;
if (private keys do not match trusted identity?) then (yes)
  :Throw VaultTrustStateInvalidError;
  stop
endif
:Verify snapshot signer, signature, and trust state;
if (snapshot trust verification fails?) then (yes)
  :Throw snapshot trust verification error;
  stop
endif
:Require snapshot is not older than the local checkpoint;

:Open vaultMasterKey from current device envelope\nwith recovered devicePrivateVaultKey;
:Decrypt snapshot content to prove recovered keys still unlock this vault;
if (snapshot is newer than the local checkpoint?) then (yes)
  :Digest snapshot and create an advanced checkpoint;
  :Atomically compare-and-save snapshot and checkpoint;
  if (snapshot changed first?) then (yes)
    :Throw LocalVaultSnapshotChangedError\nwithout changing snapshot or checkpoint;
    stop
  endif
endif

:Generate new master-password salt and local-keys protection salt;
:Derive localRootKey from newMasterPassword;
:Derive localKeysProtectionKey;
:Wrap local keys payload for new master password;

:Generate replacement recoverySecretKey;
:Convert replacement recovery key to replacement mnemonic;
:Generate replacement recovery local-keys protection salt;
:Derive replacement recovery local-keys protection key;
:Wrap same local keys payload for replacement recovery backup;

:Build both replacements with next revisions\nand the selected localAccessGenerationId;
:Atomically compare-and-save both records using the\ncaptured revisions and localAccessGenerationId;
if (either persisted revision or generation changed first?) then (yes)
  :Throw DeviceAccessMaterialChangedError\nwithout changing either record;
  stop
endif
:Return deviceId and replacement recoveryMnemonicKey;
note right
The returned words protect only the current local backup.
Retained older backup copies remain usable with their original words
while this device identity remains trusted. See the security spec,
section 8.6, for the accepted rollback limitation.
end note
stop
@enduml
