@startuml copy-entry-password-activity
title CopyEntryPasswordUseCase - Activity

skinparam backgroundColor #FEFEFE
skinparam roundcorner 8
skinparam shadowing false
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
}

start
:Input:\nvaultId, entryId, clearAfterMs;
:Source:\npackages/core/src/use-cases/clipboard/copy-entry-password.ts;
:Validate clearAfterMs before reading password;
if (invalid delay?) then (yes)
  :Throw InvalidClipboardClearDelayError;
  stop
endif

:Enter shared cross-context clipboard operation coordinator;
:Within it, require unlocked vault context for "copy entry password";
:Find active entry by entryId;
if (entry missing?) then (yes)
  :Throw PasswordEntryNotFoundError;
  stop
endif

:Compute clearScheduledAt = now + clearAfterMs;
:Load previous clipboard clear task;
if (previous task exists?) then (yes)
  :Clear previous copied value\nwith requireExpired = false;
  if (previous clear succeeds?) then (yes)
    :Cancel previous scheduled clearClipboard task;
  else (no)
    :Preserve previous metadata and any existing scheduled retry;
    :Throw previous clear failure;
    stop
  endif
endif

:Generate new actionId;
:Hash plaintext password for metadata;
note right
Stored clear metadata contains only:
actionId, copiedValueHash, expiresAt.
It does not store the plaintext password.
end note
:Save new clipboard clear task metadata;

if (schedule clearClipboard task succeeds?) then (yes)
  :Continue;
else (no)
  :Best effort remove clipboard clear task metadata;
  note right
  If removal also fails, non-plaintext metadata can remain
  without an alarm. The scheduling failure stays the root error.
  end note
  :Throw schedule failure;
  stop
endif

if (write plaintext password to clipboard succeeds?) then (yes)
  :Return { copied: true };
  stop
else (no)
  :Retain scheduled clearClipboard task and metadata;
  note right
  The OS write may have committed before the adapter
  observed the failure. The scheduled task verifies the
  clipboard hash and either clears it or releases metadata.
  end note
  :Throw original clipboard write failure;
  stop
endif
@enduml
