@startuml change-master-password-activity
title ChangeMasterPasswordUseCase - Activity

skinparam backgroundColor #FEFEFE
skinparam roundcorner 8
skinparam shadowing false
skinparam activity {
  BackgroundColor #E3F2FD
  BorderColor #1976D2
}

start
:Input:\nvaultId, currentMasterPassword, newMasterPassword;
:Source:\npackages/core/src/use-cases/vault-lifecycle/change-master-password.ts;
:Calculate newMasterPassword strength;
if (password score below 4?) then (yes)
  :Throw InvalidNewMasterPasswordError;
  stop
endif
:Read unlocked vault session;
if (session missing or different vault?) then (yes)
  :Throw VaultMustBeUnlockedForMasterPasswordChangeError;
  stop
endif

:Persist mutation for the active session\n(serializes with lock and other password changes);
:Load device access material and capture its\nrevision and localAccessGenerationId;
if (missing?) then (yes)
  :Throw DeviceAccessMaterialNotFoundForMasterPasswordChangeError;
  stop
endif

if (material vault/device differs from active session?) then (yes)
  :Throw DeviceAccessMaterialIdentityMismatchError;
  stop
endif

if (device access material algorithm unsupported?) then (yes)
  :Throw UnsupportedAlgorithmSuiteError;
  stop
endif

:Find active device in verified trust state;
:Verify material and trusted public key pairs\nmatch the active session private keys;
if (trusted device missing or any key pair differs?) then (yes)
  :Throw DeviceAccessMaterialIdentityMismatchError;
  stop
endif

:Derive current localRootKey from currentMasterPassword;
:Derive current localKeysProtectionKey;
:Unwrap local keys payload;
:Verify unwrapped private keys match material public keys;
if (any unwrapped key pair differs?) then (yes)
  :Throw DeviceAccessMaterialIdentityMismatchError;
  stop
endif
:Generate new master password salt;
:Derive new localRootKey from newMasterPassword;
:Generate new local keys protection salt;
:Derive new localKeysProtectionKey;
:Wrap same local keys payload with new protection key;
:Increment material revision;
:Compare-and-save updated material using captured\nrevision and localAccessGenerationId\n(new salts + protectedLocalKeys);
if (persisted revision or generation changed first?) then (yes)
  :Throw DeviceAccessMaterialChangedError\nwithout overwriting persisted material;
  stop
endif
:Return void;
stop
@enduml
