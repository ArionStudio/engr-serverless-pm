{
  "name": "@lfspm/extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "./scripts/build.sh",
    "build:chromium": "LFSPM_BROWSER_TARGET=chromium ./scripts/build.sh",
    "build:firefox": "LFSPM_BROWSER_TARGET=firefox ./scripts/build.sh",
    "build:all": "pnpm run build:chromium && pnpm run build:firefox",
    "gallery:build": "pnpm run gallery:check && tsc -b && vite build --config ./config/vite.gallery.config.ts",
    "gallery:preview": "vite preview --config ./config/vite.gallery.config.ts",
    "check:bip39-bundle": "bash ./scripts/check-bip39-bundle.sh",
    "test": "vitest",
    "lint": "eslint --config ./config/eslint.config.mjs .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit -p tsconfig.typecheck.json",
    "gallery:inventory": "node scripts/gallery-api.cjs --write",
    "gallery:check": "node scripts/gallery-api.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@lfspm/core": "workspace:*",
    "@scure/bip39": "2.4.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "dexie": "^4.3.0",
    "json-canonicalize": "2.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.12.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.33",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.0.17"
  }
}
